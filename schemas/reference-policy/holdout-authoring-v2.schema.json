{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentproof.dev/schemas/reference-policy/holdout-authoring-v2.schema.json",
  "oneOf": [{ "$ref": "#/definitions/evidenceCorpusV2" }, { "$ref": "#/definitions/boundaryCorpusV2" }],
  "definitions": {
    "nulFree": { "type": "string", "pattern": "^[^\\u0000]*$" },
    "sha256": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "pattern": "^[a-f0-9]{64}$" }] },
    "gitSha": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "pattern": "^[a-f0-9]{40,64}$" }] },
    "identifier": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "pattern": "^[a-z][a-z0-9_]{0,31}$" }] },
    "safePath": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,200}$" }] },
    "text50": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 50 }] },
    "text60": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 60 }] },
    "text125": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 125 }] },
    "text2000": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 2000 }] },
    "text6000": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 6000 }] },
    "evidenceCorpusV2": { "type": "object", "additionalProperties": false, "required": ["version", "cases"], "properties": { "version": { "const": 2 }, "cases": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/definitions/releaseCandidateCaseV2" } } } },
    "releaseCandidateCaseV2": { "type": "object", "additionalProperties": false, "required": ["version", "caseId", "input"], "properties": { "version": { "const": 2 }, "caseId": { "$ref": "#/definitions/sha256" }, "input": { "$ref": "#/definitions/pullRequestInputV2" } } },
    "boundaryCorpusV2": { "type": "object", "additionalProperties": false, "required": ["version", "cases"], "properties": { "version": { "const": 2 }, "cases": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/definitions/productionBoundaryCaseV2" } } } },
    "productionBoundaryCaseV2": { "oneOf": [{ "$ref": "#/definitions/inboundUntrustedV2" }, { "$ref": "#/definitions/pastedMergeV2" }] },
    "pullRequestInputV2": { "type": "object", "additionalProperties": false, "required": ["title", "description", "taskText", "changedFiles", "checks", "logs", "sourceProvenance", "verificationContractSourceV2", "verificationContractBindingV2", "verificationCriterionEvidenceV2"], "properties": { "title": { "$ref": "#/definitions/text125" }, "description": { "$ref": "#/definitions/text2000" }, "taskText": { "$ref": "#/definitions/text2000" }, "changedFiles": { "type": "array", "maxItems": 120, "items": { "$ref": "#/definitions/changedFileV2" } }, "checks": { "type": "array", "const": [] }, "logs": { "type": "array", "const": [] }, "sourceProvenance": { "$ref": "#/definitions/sourceProvenanceV1" }, "verificationContractSourceV2": { "$ref": "#/definitions/contractSourceV2" }, "verificationContractBindingV2": { "$ref": "#/definitions/verificationContractBindingV2" }, "verificationCriterionEvidenceV2": { "$ref": "#/definitions/verificationCriterionEvidenceV2" } } },
    "changedFileV2": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "$ref": "#/definitions/safePath" }, "previousPath": { "$ref": "#/definitions/safePath" }, "status": { "enum": ["added", "modified", "removed", "renamed"] } } },
    "sourceProvenanceV1": { "type": "object", "additionalProperties": false, "required": ["version", "origin", "evidenceCapturedAt", "inputFingerprint"], "properties": { "version": { "const": 1 }, "origin": { "const": "github_snapshot" }, "evidenceCapturedAt": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 25 }] }, "inputFingerprint": { "$ref": "#/definitions/inputFingerprintV1" }, "headSha": { "$ref": "#/definitions/gitSha" }, "baseSha": { "$ref": "#/definitions/gitSha" }, "changedFileInventory": { "$ref": "#/definitions/changedFileInventoryV1" } } },
    "inputFingerprintV1": { "type": "object", "additionalProperties": false, "required": ["version", "algorithm", "value", "coverage"], "properties": { "version": { "const": 1 }, "algorithm": { "const": "sha256" }, "value": { "$ref": "#/definitions/sha256" }, "coverage": { "const": "github_metadata" } } },
    "changedFileInventoryV1": { "type": "object", "additionalProperties": false, "required": ["version", "completeness"], "properties": { "version": { "const": 1 }, "completeness": { "enum": ["complete", "incomplete"] }, "headSha": { "$ref": "#/definitions/gitSha" } } },
    "verificationContractBindingV2": { "type": "object", "additionalProperties": false, "required": ["sourceKind", "sourceIdentity", "sourceContent", "headSha", "baseSha"], "properties": { "sourceKind": { "enum": ["provided_requirement", "linked_issue", "pr_description"] }, "sourceIdentity": { "$ref": "#/definitions/text125" }, "sourceContent": { "$ref": "#/definitions/text6000" }, "headSha": { "$ref": "#/definitions/gitSha" }, "baseSha": { "$ref": "#/definitions/gitSha" } } },
    "verificationCriterionEvidenceV2": { "type": "object", "additionalProperties": false, "required": ["artifactBlobs"], "properties": { "artifactBlobs": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/artifactBlobV2" } } } },
    "artifactBlobV2": { "type": "object", "additionalProperties": false, "required": ["path", "content"], "properties": { "path": { "$ref": "#/definitions/safePath" }, "headSha": { "$ref": "#/definitions/gitSha" }, "content": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 16384 }] } } },
    "contractSourceV2": { "oneOf": [{ "$ref": "#/definitions/providedRequirementSourceV2" }, { "$ref": "#/definitions/linkedIssueSourceV2" }, { "$ref": "#/definitions/prDescriptionSourceV2" }] },
    "providedRequirementSourceV2": { "type": "object", "additionalProperties": false, "required": ["kind", "contract"], "properties": { "kind": { "const": "provided_requirement" }, "contract": { "$ref": "#/definitions/verificationContractV2" } } },
    "linkedIssueSourceV2": { "type": "object", "additionalProperties": false, "required": ["kind", "title", "body"], "properties": { "kind": { "const": "linked_issue" }, "title": { "const": "AgentProof verification contract" }, "body": { "$ref": "#/definitions/text6000" } } },
    "prDescriptionSourceV2": { "type": "object", "additionalProperties": false, "required": ["kind", "title", "body"], "properties": { "kind": { "const": "pr_description" }, "title": { "const": "AgentProof verification contract" }, "body": { "$ref": "#/definitions/text6000" } } },
    "verificationContractV2": { "type": "object", "additionalProperties": false, "required": ["version", "scope", "objectives"], "properties": { "version": { "const": 2 }, "scope": { "const": "complete_objective_set" }, "objectives": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/definitions/objectiveV2" } } } },
    "objectiveV2": { "type": "object", "additionalProperties": false, "required": ["id", "objective", "criteria"], "properties": { "id": { "$ref": "#/definitions/identifier" }, "objective": { "$ref": "#/definitions/text125" }, "criteria": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/criterionV2" } } } },
    "criterionV2": { "oneOf": [{ "$ref": "#/definitions/absenceCriterionV2" }, { "$ref": "#/definitions/artifactCriterionV2" }, { "$ref": "#/definitions/returnValueCriterionV2" }] },
    "absenceCriterionV2": { "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "prohibitedKind", "scope"], "properties": { "id": { "$ref": "#/definitions/identifier" }, "type": { "const": "absence" }, "label": { "$ref": "#/definitions/text60" }, "prohibitedKind": { "const": "path_change" }, "scope": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/scopeV2" } } } },
    "scopeV2": { "oneOf": [{ "$ref": "#/definitions/exactScopeV2" }, { "$ref": "#/definitions/prefixScopeV2" }] },
    "exactScopeV2": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "exact" }, "path": { "$ref": "#/definitions/safePath" } } },
    "prefixScopeV2": { "type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": { "kind": { "const": "prefix" }, "path": { "allOf": [{ "$ref": "#/definitions/safePath" }, { "pattern": ".*/$" }] } } },
    "artifactCriterionV2": { "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "paths", "artifact"], "properties": { "id": { "$ref": "#/definitions/identifier" }, "type": { "const": "artifact" }, "label": { "$ref": "#/definitions/text60" }, "paths": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/definitions/safePath" } }, "artifact": { "$ref": "#/definitions/artifactV2" } } },
    "artifactV2": { "oneOf": [{ "$ref": "#/definitions/documentationArtifactV2" }, { "$ref": "#/definitions/testArtifactV2" }, { "$ref": "#/definitions/workflowArtifactV2" }] },
    "documentationArtifactV2": { "type": "object", "additionalProperties": false, "required": ["kind", "literal"], "properties": { "kind": { "const": "documentation_literal" }, "literal": { "$ref": "#/definitions/text50" } } },
    "testArtifactV2": { "type": "object", "additionalProperties": false, "required": ["kind", "testId"], "properties": { "kind": { "const": "test_case" }, "testId": { "$ref": "#/definitions/text50" } } },
    "workflowArtifactV2": { "type": "object", "additionalProperties": false, "required": ["kind", "workflowName", "jobName"], "properties": { "kind": { "const": "workflow_job" }, "workflowName": { "$ref": "#/definitions/text50" }, "jobName": { "$ref": "#/definitions/text50" }, "runtimeName": { "$ref": "#/definitions/text50" }, "runtimeVersion": { "$ref": "#/definitions/text50" }, "packageScript": { "$ref": "#/definitions/text50" } } },
    "returnValueCriterionV2": { "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "adapter", "cases"], "properties": { "id": { "$ref": "#/definitions/identifier" }, "type": { "const": "return_value" }, "label": { "$ref": "#/definitions/text60" }, "adapter": { "$ref": "#/definitions/adapterV2" }, "cases": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/returnCaseV2" } } } },
    "adapterV2": { "oneOf": [{ "$ref": "#/definitions/nodeAdapterV2" }, { "$ref": "#/definitions/pythonAdapterV2" }] },
    "nodeAdapterV2": { "type": "object", "additionalProperties": false, "required": ["id", "modulePath", "exportName", "moduleFormat"], "properties": { "id": { "const": "node_export_scalar.v1" }, "modulePath": { "$ref": "#/definitions/safePath" }, "exportName": { "$ref": "#/definitions/identifier" }, "moduleFormat": { "enum": ["esm", "commonjs"] } } },
    "pythonAdapterV2": { "type": "object", "additionalProperties": false, "required": ["id", "modulePath", "functionName"], "properties": { "id": { "const": "python_function_scalar.v1" }, "modulePath": { "$ref": "#/definitions/safePath" }, "functionName": { "$ref": "#/definitions/identifier" } } },
    "scalarV2": { "oneOf": [{ "type": "null" }, { "type": "boolean" }, { "type": "number", "minimum": -9007199254740991, "maximum": 9007199254740991 }, { "$ref": "#/definitions/text50" }] },
    "returnCaseV2": { "type": "object", "additionalProperties": false, "required": ["id", "expected"], "properties": { "id": { "$ref": "#/definitions/identifier" }, "input": { "$ref": "#/definitions/scalarV2" }, "expected": { "$ref": "#/definitions/scalarV2" } } },
    "inboundUntrustedV2": { "type": "object", "additionalProperties": false, "required": ["version", "kind", "caseId", "report"], "properties": { "version": { "const": 2 }, "kind": { "const": "inbound_untrusted_v2" }, "caseId": { "$ref": "#/definitions/sha256" }, "report": { "$ref": "#/definitions/minimalReportV2" } } },
    "minimalReportV2": { "type": "object", "additionalProperties": false, "required": ["reportSchemaVersion", "verificationContract"], "properties": { "reportSchemaVersion": { "const": "verification-report.v2" }, "verificationContract": { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "enum": ["authoritative", "author_claim"] } } } } },
    "pastedMergeV2": { "type": "object", "additionalProperties": false, "required": ["version", "kind", "caseId", "liveInput", "pastedOverride"], "properties": { "version": { "const": 2 }, "kind": { "const": "pasted_merge" }, "caseId": { "$ref": "#/definitions/sha256" }, "liveInput": { "$ref": "#/definitions/pullRequestInputV2" }, "pastedOverride": { "$ref": "#/definitions/pastedOverrideV2" } } },
    "pastedOverrideV2": { "type": "object", "additionalProperties": false, "properties": { "prUrl": { "$ref": "#/definitions/text2000" }, "taskText": { "$ref": "#/definitions/text2000" }, "prDescription": { "$ref": "#/definitions/text2000" }, "changedFiles": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 3000 }] }, "checks": { "$ref": "#/definitions/text6000" }, "logs": { "$ref": "#/definitions/text6000" }, "inputLimitations": { "type": "array", "maxItems": 32, "items": { "allOf": [{ "$ref": "#/definitions/nulFree" }, { "maxLength": 250 }] } } } }
  }
}
