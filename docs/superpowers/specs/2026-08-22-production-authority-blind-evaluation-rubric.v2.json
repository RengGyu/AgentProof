  "scoreCategories": [{"id":"closed_reference_v2","label":"Closed reference V2","weight":100,"criteria":[{"id":"all_required_evidence","points":100,"requiredEvidenceSourceIds":["freeze_manifest","protected_aggregate","protected_boundary_aggregate","runner_isolation_attestation","rubric_executor_regression","untrusted_authority_regression","generated_private_regression","pasted_provenance_regression","privacy_regression","contract_endpoint_replay","engineering_suite","external_regression","production_smoke","independent_review"]}]}],
  "decisionBands": [{"minimumScore":0,"maximumScore":99,"decision":"no_go","condition":"always"},{"minimumScore":100,"maximumScore":100,"decision":"eligible_for_deployment_approval","condition":"all_binary_gates_pass"}],
