    "goals": [
      {
        "id": "goal_1",
        "summary": "Correct GC tracking and traversal behavior across validator and serializer callables, including avoiding duplicate traversal of Arc-owned subtrees, enabling GC hooks on affected info/callable/iterator types, and cleaning up obsolete DefinitionRef handling and ownership documentation.",
        "emphasis": "primary",
        "authority": "pr_author_claim",
        "facets": [
          {
            "kind": "motivation",
            "summary": "Avoid visiting objects twice for one reference when an Arc clone points to a subtree already owned and traversed by its unique owner."
          },
          {
            "kind": "condition",
            "summary": "Do not traverse InternalValidator.validator from the GC hooks of ValidatorCallable, AssignmentValidatorCallable, or ValidatorIterator."
          },
          {
            "kind": "condition",
            "summary": "Apply the corresponding traversal change to SerializationCallable.serializer and SerializationIterator.item_serializer."
          },
          {
            "kind": "implementation_claim",
            "summary": "The described fields are Arc clones of subtrees already owned and traversed by SchemaValidator; the serializer fields have the analogous ownership relationship."
          },
          {
            "kind": "condition",
            "summary": "Place __traverse__ and __clear__ for ValidationInfo, SerializationInfo, SerializationCallable, and SerializationIterator inside the referenced code so these types receive GC tracking."
          },
          {
            "kind": "implementation_claim",
            "summary": "The GC methods were defined outside the referenced code, and the affected types were therefore not GC-tracked, according to the PR description."
          },
          {
            "kind": "condition",
            "summary": "Remove the unused PyGcTraverse implementation for DefinitionRef and document that an Arc should only be traversed by its unique owner."
          }
        ],
