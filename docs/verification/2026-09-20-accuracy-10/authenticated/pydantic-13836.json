      "context": [
        {
          "id": "ctx_1",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "`pydantic/v1/_hypothesis_plugin.py` ships with Pydantic V2"
        },
        {
          "id": "ctx_2",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "But it imported the top-level names `pydantic`, `pydantic.color` and `pydantic.types`"
        },
        {
          "id": "ctx_3",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "Under V2, those names point to the V2 modules"
        },
        {
          "id": "ctx_4",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "So the V1-only names that the module reads from them (`color.r_rgba`, `types.ConstrainedNumberMeta`, `types._DEFINED_TYPES`) raised `AttributeError` at import time"
        },
        {
          "id": "ctx_5",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "The plugin could not be imported at all"
        },
        {
          "id": "ctx_6",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "This change points the import at the V1 namespace:"
        },
        {
          "id": "ctx_7",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "import pydantic"
        },
        {
          "id": "ctx_8",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "import pydantic.color"
        },
        {
          "id": "ctx_9",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "import pydantic.types"
        },
        {
          "id": "ctx_10",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "+import pydantic.v1 as pydantic"
        },
        {
          "id": "ctx_11",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "The package `pydantic.v1` already exposes `color` and `types` as attributes"
        },
        {
          "id": "ctx_12",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "So one aliased import is enough"
        },
        {
          "id": "ctx_13",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "A separate `import pydantic.v1.color` is not needed"
        },
        {
          "id": "ctx_14",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Change Summary",
          "text": "That form would also break: `import a.b.c` without `as` binds the top-level name `pydantic` again and overwrites the alias"
        },
        {
          "id": "ctx_15",
          "source": "pr_description",
          "role": "author_claim",
          "sourceQuality": "author_claim",
          "sourceSection": "Related issue number",
          "text": "fix #13835"
        }
      ],
